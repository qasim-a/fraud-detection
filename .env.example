# Copy to .env. Never commit real secrets.
POSTGRES_DB=fraud_detection
POSTGRES_USER=fraud_app
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://fraud_app:local-development-only@postgres:5432/fraud_detection
MODEL_ARTIFACT_PATH=/artifacts/models/active/model.json
MODEL_METADATA_PATH=/artifacts/models/active/metadata.json
ARTIFACT_ROOT=/artifacts
LOG_LEVEL=INFO
API_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
